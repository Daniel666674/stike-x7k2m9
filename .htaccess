# =============================================================================
# Stike Bike Shop — configuracion del hosting (Hostinger, LiteSpeed/Apache):
# HTTPS, rutas de la API, archivos internos bloqueados, cacheo y seguridad.
#
# Solo se activa en Hostinger. La demo en GitHub Pages no lee .htaccess ni
# permite headers custom; ahi esto no hace nada.
#
# Regla de cacheo (ver correctness rule #5 del panel admin):
#   - HTML: nunca se cachea, cada carga refleja la ultima publicacion.
#   - JS/CSS/imagenes/video: 1 año, immutable. El cache-busting se maneja
#     SOLO con el query string ?v=N en cada <script>/<link>/<img> — si
#     editas el CONTENIDO de un archivo compartido (styles.css, data.js,
#     app.js, pdp.js, pdp-render.js, products-data.js) tenes que subir
#     tambien el numero de version en TODOS los HTML que lo referencian,
#     si no los visitantes con cache siguen viendo la version vieja.
# =============================================================================

Options -Indexes

# Pagina de error propia (404.html): con menu y enlaces, no un 404 mudo. Es
# noindex, asi que no se indexa; solo evita perder al visitante y a los
# rastreadores que llegan a un enlace viejo.
ErrorDocument 404 /404.html

# La pagina de inicio es siempre index.html (si Hostinger dejo un default.php o
# index.php de relleno, no tapa el sitio).
DirectoryIndex index.html

# ------------------------- HTTPS, www y rutas de la API ----------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Todo por HTTPS y sin "www": un solo sitio para Google y para los pagos.
  # (El webhook de Wompi se registra con la URL final exacta, sin redirecciones:
  # un POST redirigido llega como GET y se pierde.)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Fichas que se fusionaron en otra: 301 real (Google transfiere la autoridad).
  # >>> seo-redirects (generado por tools/build-seo.mjs; no editar)
  RewriteRule ^producto/bielas-federal-vice-160mm-negras\.html$ /producto/bielas-federal-vice.html [R=301,L]
  RewriteRule ^producto/bielas-federal-vice-2-cromadas-175mm\.html$ /producto/bielas-federal-vice.html [R=301,L]
  RewriteRule ^producto/bielas-fiend-segment-22mm-cromadas\.html$ /producto/bielas-fiend-segment-22mm.html [R=301,L]
  RewriteRule ^producto/bielas-fiend-segment-22mm-negras-170mm\.html$ /producto/bielas-fiend-segment-22mm.html [R=301,L]
  RewriteRule ^producto/brazos-salt-de-seguridad-175-negro\.html$ /producto/bielas-salt-de-seguridad-negras.html [R=301,L]
  RewriteRule ^producto/buzo-sm-negro\.html$ /producto/buzo-sm-bmx-negro.html [R=301,L]
  RewriteRule ^producto/caja-de-centro-fate-1019mm-negra\.html$ /producto/caja-de-centro-fate-negra.html [R=301,L]
  RewriteRule ^producto/caja-de-centro-fate-1022mm-negra\.html$ /producto/caja-de-centro-fate-negra.html [R=301,L]
  RewriteRule ^producto/caja-de-centro-odyssey-1019mm-negra\.html$ /producto/caja-de-centro-odyssey-negra.html [R=301,L]
  RewriteRule ^producto/caja-de-centro-odyssey-1022mm-negra\.html$ /producto/caja-de-centro-odyssey-negra.html [R=301,L]
  RewriteRule ^producto/caja-fiend-centro-mid-22mm-ransom-cromada\.html$ /producto/caja-de-centro-fiend-mid-22mm-ransom.html [R=301,L]
  RewriteRule ^producto/caja-fiend-centro-mid-22mm-ransom-negra\.html$ /producto/caja-de-centro-fiend-mid-22mm-ransom.html [R=301,L]
  RewriteRule ^producto/caja-fiend-frente-integrado-ransom-cromada\.html$ /producto/caja-de-frente-fiend-frente-integrado-ransom.html [R=301,L]
  RewriteRule ^producto/caja-fiend-frente-integrado-ransom-negra\.html$ /producto/caja-de-frente-fiend-frente-integrado-ransom.html [R=301,L]
  RewriteRule ^producto/camiseta-fate-blanca\.html$ /producto/camiseta-fate-bmx.html [R=301,L]
  RewriteRule ^producto/camiseta-fate-negra\.html$ /producto/camiseta-fate-bmx.html [R=301,L]
