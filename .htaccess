  RewriteRule ^producto/plato-fiend-reynolds-negro-25t-sin-guardia\.html$ /producto/plato-fiend-reynolds-25t.html [R=301,L]
  RewriteRule ^producto/plato-gw-corona-negro-25t\.html$ /producto/plato-gw-corona.html [R=301,L]
  RewriteRule ^producto/plato-gw-corona-negro-28t\.html$ /producto/plato-gw-corona.html [R=301,L]
  RewriteRule ^producto/plato-mutanty-diamond-cromado\.html$ /producto/plato-mutanty-diamond-con-guardia.html [R=301,L]
  RewriteRule ^producto/plato-mutanty-diamond-negro\.html$ /producto/plato-mutanty-diamond-con-guardia.html [R=301,L]
  RewriteRule ^producto/plato-odyssey-utility-pro-negro-25t\.html$ /producto/plato-odyssey-utility-pro-negro.html [R=301,L]
  RewriteRule ^producto/plato-odyssey-utility-pro-negro-28t\.html$ /producto/plato-odyssey-utility-pro-negro.html [R=301,L]
  RewriteRule ^producto/poste-pivotal-fiend-185mm-cromado\.html$ /producto/poste-pivotal-fiend-185mm.html [R=301,L]
  RewriteRule ^producto/poste-pivotal-fiend-185mm-negro\.html$ /producto/poste-pivotal-fiend-185mm.html [R=301,L]
  RewriteRule ^producto/poste-pivotal-optimus-corto-negro\.html$ /producto/poste-pivotal-optimus.html [R=301,L]
  RewriteRule ^producto/poste-pivotal-optimus-largo-negro\.html$ /producto/poste-pivotal-optimus.html [R=301,L]
  RewriteRule ^producto/protector-maza-odyssey-clutch-v2-negro\.html$ /producto/protector-manzana-trasera-odyssey-clutch-v2-negro.html [R=301,L]
  RewriteRule ^producto/silla-mutanty-camuflada\.html$ /producto/silla-mutanty.html [R=301,L]
  RewriteRule ^producto/silla-mutanty-negra\.html$ /producto/silla-mutanty.html [R=301,L]
  RewriteRule ^producto/tenedor-fiend-invest-v2-26mm-cromado\.html$ /producto/tenedor-fiend-invest-v2-26mm.html [R=301,L]
  RewriteRule ^producto/tenedor-fiend-invest-v2-26mm-negro\.html$ /producto/tenedor-fiend-invest-v2-26mm.html [R=301,L]
  RewriteRule ^producto/tenedor-fiend-process-ic-v2-20mm-cromado\.html$ /producto/tenedor-fiend-process-ic-v2-20mm.html [R=301,L]
  RewriteRule ^producto/tenedor-fiend-process-ic-v2-20mm-negro\.html$ /producto/tenedor-fiend-process-ic-v2-20mm.html [R=301,L]
  RewriteRule ^producto/timon-fiend-reynolds-cromado\.html$ /producto/timon-fiend-reynolds.html [R=301,L]
  RewriteRule ^producto/timon-fiend-reynolds-negro\.html$ /producto/timon-fiend-reynolds.html [R=301,L]
  RewriteRule ^producto/timon-fiend-team-cromado\.html$ /producto/timon-fiend-team.html [R=301,L]
  RewriteRule ^producto/timon-fiend-team-negro\.html$ /producto/timon-fiend-team.html [R=301,L]
  RewriteRule ^producto/vielas-de-seguridad-salt-165-negra\.html$ /producto/bielas-salt-de-seguridad-negras.html [R=301,L]
  RewriteRule ^categoria/espigas\.html$ /categoria/canas.html [R=301,L]
  RewriteRule ^categoria/manzanas\.html$ /categoria/manzana-trasera.html [R=301,L]
  RewriteRule ^categoria/tacos-y-protectores-de-maza\.html$ /categoria/pegs-y-protectores.html [R=301,L]
  # <<< seo-redirects

  # Algunos hostings PHP descartan el header Authorization antes de llegar a
  # PHP; api/sales.php lo necesita para validar la clave del panel.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # El front llama /api/wompi-sign (igual que el backend de Vercel); aca se
  # traduce al archivo PHP.
  RewriteRule ^api/(wompi-sign|wompi-status|wompi-order|wompi-events|sales|sync|admin-login|admin-health|gh)/?$ api/$1.php [L]

  # Panel admin: el HTML y el codigo SOLO salen por admin.php, que exige una
  # sesion iniciada (cookie firmada, verificada en el servidor). Sin sesion
  # se ve unicamente la pantalla de "Iniciar sesion".
  RewriteRule ^admin(\.html)?/?$ admin.php?f=html [L,QSA]
  RewriteRule ^admin\.js$ admin.php?f=js [L,QSA]

  # Segunda capa: lo interno no se sirve nunca, aunque algun dia llegue al
  # hosting por error. (El deploy ya lo deja fuera: tools/stage-hostinger.sh.)
  RewriteRule ^(tools|vercel-wompi-api|bmx-builder|\.github|node_modules)(/|$) - [F,L]
  RewriteRule ^data/(costs|sales-log|audit-log)\.json$ - [F,L]
  RewriteRule ^(PROPOSAL|MOTOR|README|SEO)\.md$ - [F,L]
  RewriteRule ^propuesta\.html$ - [F,L]
  RewriteRule ^\.git(/|$) - [F,L]
  RewriteRule ^api/(_lib|_admin|config\.local)\.php$ - [F,L]
</IfModule>

# ----------------------------- Cacheo ---------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|jpe?g|png|webp|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # El catalogo trae el STOCK: cada venta (tienda u online) lo cambia, asi
  # que nunca se guarda en cache -- si no, un visitante veria unidades viejas.
  <Files "products-data.js">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </Files>

  # data/*.json (sales/audit/costs/site-content) las escribe el panel admin
  # y las lee la propia app en vivo (KPIs, textos editables): tampoco se
  # cachean, para que un publish se refleje de inmediato.
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # Lo que NO es una pagina (la API, el panel, los JSON de datos) nunca se
  # indexa, aunque alguien lo enlace desde fuera.
  <FilesMatch "\.(php|json)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # El service worker del admin (admin-sw.js) no lleva cache HTTP largo:
  # necesita que el navegador pueda detectar una version nueva sin esperar
  # el ciclo de "1 año immutable" del resto de los .js.
  <Files "admin-sw.js">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </Files>

  # ------------------------------- Seguridad ---------------------------------
  # CSP: solo los terceros que el sitio realmente usa — Google Fonts, el embed de Google Maps
  # (contacto.html), el video de YouTube del inicio (index.html: script de la API en script-src y el
  # reproductor en frame-src; sin esto el navegador los bloquea y el recuadro queda negro; lo cubre
  # tools/youtube-home-test.mjs, que lee esta misma linea) y Wompi (el widget de pago: script, iframe y, si el widget
  # no carga, el formulario de respaldo). Nuestra propia API (/api/...) es del
  # mismo origen, no necesita permiso aparte. Sin wildcards, salvo *.wompi.co:
  # el widget de Wompi usa varios de sus subdominios (checkout, production,
  # sandbox) y un host que falte aca rompe el cobro sin avisar; es la
  # procesadora de pagos, no un tercero cualquiera.
  # `script-src` incluye 'unsafe-inline' porque el sitio (heredado del mockup
  # original) usa manejadores inline (onclick=...); migrar eso a
  # addEventListener queda pendiente como mejora.
  #
  # accounts.google.com (script-src + frame-src + connect-src) es del boton
  # de login del panel. GitHub y la verificacion del login de Google los hace
  # el SERVIDOR (api/gh.php, api/admin-login.php), no el navegador.
  #
  # SIN PROBAR contra el widget real de Wompi (el entorno donde se escribio no
  # llega a checkout.wompi.co). Despues del primer deploy: abrir el carrito, dar
  # "Pagar ahora" y mirar la consola del navegador; cualquier linea
  # "Refused to ..." dice exactamente que host falta agregar aca.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://www.youtube.com https://*.wompi.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://accounts.google.com https://*.wompi.co; frame-src https://maps.google.com https://www.google.com https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com https://*.wompi.co; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://*.wompi.co; object-src 'none'"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ----------------------------- Compresion ------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
