  RewriteRule ^producto/funda-peg-fate-45\.html$ /producto/cubierta-peg-fate.html [R=301,L]
  RewriteRule ^producto/llavero-pedal-kboom-v2-amarillo\.html$ /producto/llavero-pedal-kboom-v2.html [R=301,L]
  RewriteRule ^producto/llavero-pedal-kboom-v2-azul-aguamarina\.html$ /producto/llavero-pedal-kboom-v2.html [R=301,L]
  RewriteRule ^producto/manzana-delantera-optimus-azul\.html$ /producto/manzana-delantera-optimus.html [R=301,L]
  RewriteRule ^producto/manzana-delantera-optimus-cromada\.html$ /producto/manzana-delantera-optimus.html [R=301,L]
  RewriteRule ^producto/manzana-optimus-gold\.html$ /producto/manzana-delantera-optimus.html [R=301,L]
  RewriteRule ^producto/marco-fiend-mills-azul\.html$ /producto/marco-fiend-mills.html [R=301,L]
  RewriteRule ^producto/marco-fiend-mills-negro\.html$ /producto/marco-fiend-mills.html [R=301,L]
