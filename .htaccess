  RewriteRule ^producto/marco-fiend-reynolds-purpura\.html$ /producto/marco-fiend-reynolds.html [R=301,L]
  RewriteRule ^producto/marco-fiend-shapershifter-320-blanco\.html$ /producto/marco-fiend-shapershifter-320.html [R=301,L]
  RewriteRule ^producto/marco-fiend-shapershifter-320-gris-mate\.html$ /producto/marco-fiend-shapershifter-320.html [R=301,L]
  RewriteRule ^producto/marco-fiend-shapershifter-320-negro\.html$ /producto/marco-fiend-shapershifter-320.html [R=301,L]
  RewriteRule ^producto/marco-fiend-shapershifter-320-rojo-corsa\.html$ /producto/marco-fiend-shapershifter-320.html [R=301,L]
  RewriteRule ^producto/pedales-demolition-trooper-azul-blanco\.html$ /producto/pedales-demolition-trooper.html [R=301,L]
  RewriteRule ^producto/pedales-demolition-trooper-azul-rojo\.html$ /producto/pedales-demolition-trooper.html [R=301,L]
  RewriteRule ^producto/pedales-demolition-trooper-blanco-negro\.html$ /producto/pedales-demolition-trooper.html [R=301,L]
  RewriteRule ^producto/pedales-demolition-trooper-morado-amarillo\.html$ /producto/pedales-demolition-trooper.html [R=301,L]
  RewriteRule ^producto/pedales-demolition-trooper-rojo-blanco\.html$ /producto/pedales-demolition-trooper.html [R=301,L]
  RewriteRule ^producto/pedales-rant-trill-azul\.html$ /producto/pedales-rant-trill.html [R=301,L]
  RewriteRule ^producto/pedales-rant-trill-morado\.html$ /producto/pedales-rant-trill.html [R=301,L]
  RewriteRule ^producto/pedales-rant-trill-negro\.html$ /producto/pedales-rant-trill.html [R=301,L]
  RewriteRule ^producto/pedales-rant-trill-rojo\.html$ /producto/pedales-rant-trill.html [R=301,L]
  RewriteRule ^producto/pedales-shadow-surface-morado\.html$ /producto/pedales-shadow-surface.html [R=301,L]
  RewriteRule ^producto/pedales-shadow-surface-negro\.html$ /producto/pedales-shadow-surface.html [R=301,L]
  RewriteRule ^producto/pedales-shadow-surface-rojo\.html$ /producto/pedales-shadow-surface.html [R=301,L]
  RewriteRule ^producto/plato-fiend-omicron-25t\.html$ /producto/plato-fiend-omicron.html [R=301,L]
  RewriteRule ^producto/plato-fiend-omicron-28t\.html$ /producto/plato-fiend-omicron.html [R=301,L]
  RewriteRule ^producto/plato-fiend-omicron-cromado-25t\.html$ /producto/plato-fiend-omicron.html [R=301,L]
  RewriteRule ^producto/plato-fiend-omicron-cromado-28t\.html$ /producto/plato-fiend-omicron.html [R=301,L]
  RewriteRule ^producto/plato-fiend-omicron-guard-cromado-26t\.html$ /producto/plato-fiend-omicron-guard.html [R=301,L]
  RewriteRule ^producto/plato-fiend-omicron-guard-negro-28t\.html$ /producto/plato-fiend-omicron-guard.html [R=301,L]
